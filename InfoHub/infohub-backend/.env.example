# Conexão com o PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infohub

# Porta da API
PORT=3333

# Segredo do JWT — troque por uma string longa e aleatória em produção
JWT_SECRET=troque-este-segredo-por-uma-string-longa-e-aleatoria
# token de ACESSO (curto); a sessão dura REFRESH_TOKEN_DIAS e renova sozinha
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=7

# Origem liberada no CORS (endereço do frontend Vite em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# ---------- e-mail dos lembretes (opcional) ----------
# Sem SMTP_HOST/SMTP_USER/SMTP_PASS o sistema roda em "modo simulação":
# os lembretes são registrados e o e-mail aparece só no log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = "senha de app"
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Se preenchido, TODO e-mail vai para este endereço (bom para demo/testes).
EMAIL_TESTE_PARA=
# Endereço público do sistema, usado no botão "Abrir no InfoHub" do e-mail.
APP_URL=http://localhost:5173
# Quantos dias antes do prazo sai o lembrete automático.
LEMBRETE_DIAS_ANTES=1
