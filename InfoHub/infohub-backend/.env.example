# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://infohub:infohub@localhost:5432/infohub

# Porta em que a API vai rodar
PORT=3333

# Segredo usado para assinar os tokens JWT — troque por um valor
# aleatório e longo em produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=7d

# Origem(ns) permitida(s) para CORS (o frontend em desenvolvimento do Vite)
CORS_ORIGIN=http://localhost:5173
